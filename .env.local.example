# ──────────────────────────────────────────────────────────────────────────────
# Renomeie este arquivo para .env.local e preencha os valores abaixo.
# NUNCA comite o arquivo .env.local no git.
# ──────────────────────────────────────────────────────────────────────────────

# Chave da Google Cloud usada pelo BACKEND (API Routes) para:
#   • Places API (New) — Nearby Search
#   • Geocoding API
# Esta variável NÃO é exposta ao navegador.
GOOGLE_PLACES_API_KEY=SUA_CHAVE_AQUI

# Chave usada pelo FRONTEND para renderizar o mapa (Google Maps JS API).
# Deve ser uma chave separada com restrição de HTTP Referrer configurada.
# Prefixo NEXT_PUBLIC_ expõe a variável ao bundle do cliente.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=SUA_CHAVE_PUBLICA_AQUI
